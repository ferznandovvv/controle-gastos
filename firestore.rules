rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só estas contas leem e escrevem. Mantenha igual à lista em public/firebase-config.js.
    function permitido() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'fernandomendoncacintra@gmail.com'
          , 'gabrielagomesfran@gmail.com'
        ];
    }

    // segredos (chave das notificações) e avisos (controle de envio) só o bot acessa.
    match /{colecao}/{documento=**} {
      allow read, write: if permitido() && !(colecao in ['segredos', 'avisos']);
    }
  }
}
